@{
    ViewData["Title"] = "Dashboard - " + ViewBag.SucursalNombre;
}

<h1>🏪 Dashboard de @ViewBag.SucursalNombre</h1>

<div style="display: flex; gap: 20px; margin-top: 30px; flex-wrap: wrap;">
    <div style="border: 1px solid #28a745; border-radius: 10px; padding: 20px; width: 200px; text-align: center;">
        <h2>📦</h2>
        <h3>Inventario</h3>
        <p>Ver productos, stock y caducidad</p>
        <a href="/Sucursal/Inventario/@ViewBag.SucursalId" style="background-color: #28a745; color: white; padding: 10px; text-decoration: none; border-radius: 5px; display: inline-block;">Ir →</a>
    </div>
    
    <div style="border: 1px solid #007bff; border-radius: 10px; padding: 20px; width: 200px; text-align: center;">
        <h2>➕</h2>
        <h3>Agregar Producto</h3>
        <p>Añadir nuevo producto al inventario</p>
        <a href="/Sucursal/AgregarProducto/@ViewBag.SucursalId" style="background-color: #007bff; color: white; padding: 10px; text-decoration: none; border-radius: 5px; display: inline-block;">Ir →</a>
    </div>
    
    <div style="border: 1px solid #ffc107; border-radius: 10px; padding: 20px; width: 200px; text-align: center;">
        <h2>💰</h2>
        <h3>Vender</h3>
        <p>Registrar una venta</p>
        <a href="/Sucursal/Vender/@ViewBag.SucursalId" style="background-color: #ffc107; color: black; padding: 10px; text-decoration: none; border-radius: 5px; display: inline-block;">Ir →</a>
    </div>
    
    <div style="border: 1px solid #dc3545; border-radius: 10px; padding: 20px; width: 200px; text-align: center;">
        <h2>📊</h2>
        <h3>Reporte</h3>
        <p>Ganancias y valor del inventario</p>
        <a href="/Sucursal/Reporte/@ViewBag.SucursalId" style="background-color: #dc3545; color: white; padding: 10px; text-decoration: none; border-radius: 5px; display: inline-block;">Ir →</a>
    </div>
</div>

<br />
<a href="/">← Cambiar de sucursal</a>