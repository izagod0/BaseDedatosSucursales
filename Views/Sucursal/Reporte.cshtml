@model List<restauranteswebsbasededatos.Models.Venta>

@{
    ViewData["Title"] = "Reporte - " + ViewBag.SucursalNombre;
    var sucursalId = ViewBag.SucursalId ?? 0;
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    body {
        background: #0f0f0f;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px;
    }
    .header {
        background: #1e1e2e;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        border: 1px solid #2a2a3e;
    }
    .header h1 {
        color: #fff;
        font-size: 28px;
        margin-bottom: 10px;
    }
    .header p {
        color: #888;
        font-size: 14px;
    }
    .stats-container {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }
    .stat-card {
        background: #1e1e2e;
        border: 1px solid #2a2a3e;
        border-radius: 15px;
        padding: 25px;
        flex: 1;
        min-width: 200px;
        text-align: center;
    }
    .stat-card h3 {
        color: #888;
        font-size: 14px;
        margin-bottom: 10px;
    }
    .stat-card .value {
        color: #7c3aed;
        font-size: 32px;
        font-weight: bold;
    }
    table {
        width: 100%;
        background: #1e1e2e;
        border-radius: 15px;
        overflow: hidden;
        border-collapse: collapse;
        margin-top: 20px;
    }
    th {
        background: #2a2a3e;
        color: #fff;
        padding: 15px;
        text-align: left;
    }
    td {
        padding: 12px 15px;
        color: #bbb;
        border-bottom: 1px solid #2a2a3e;
    }
    tr:hover {
        background: #252536;
    }
    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #888;
        text-decoration: none;
        margin-right: 15px;
    }
</style>

<div class="container">
    <div class="header">
        <h1>📊 Reporte - @ViewBag.SucursalNombre</h1>
        <p>Análisis de ventas y valor del inventario</p>
    </div>

    <div class="stats-container">
        <div class="stat-card">
            <h3>💰 Total en Ventas</h3>
            <div class="value">$@ViewBag.TotalVentas</div>
        </div>
        <div class="stat-card">
            <h3>📦 Valor del Inventario</h3>
            <div class="value">$@ViewBag.ValorInventario</div>
        </div>
    </div>

    <h3 style="color: #fff;">Últimas Ventas</h3>

    @if (Model.Count == 0)
    {
        <p style="color: #888;">No hay ventas registradas.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venta in Model)
                {
                    <tr>
                        <td>@venta.ProductoNombre</td>
                        <td>@venta.Cantidad</td>
                        <td>$@venta.Total</td>
                        <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <br />
    <a href="/Gerente/Dashboard/@sucursalId" class="back-link">← Volver al Dashboard del Gerente</a>
</div>