@model List<restauranteswebsbasededatos.Models.Producto>

@{
    ViewData["Title"] = "Agregar Producto a Sucursal";
}

<h1>➕ Agregar Producto a la Sucursal</h1>

@if (Model == null || Model.Count == 0)
{
    <p style="color:orange;">⚠️ No hay productos disponibles para agregar.</p>
    <p>Primero debes crear productos en <a href="/Productos">/Productos</a></p>
}
else
{
    <form action="/Sucursal/AgregarProducto" method="post">
        <input type="hidden" name="sucursalId" value="@ViewBag.SucursalId" />

        <div>
            <label>Producto:</label>
            <select name="productoId" required>
                <option value="">Selecciona un producto</option>
                @foreach (var producto in Model)
                {
                    <option value="@producto.Id">@producto.Nombre - $@producto.Precio</option>
                }
            </select>
        </div>

        <div>
            <label>Cantidad inicial:</label>
            <input type="number" name="cantidad" min="1" required />
        </div>

        <div>
            <input type="submit" value="Agregar" />
        </div>
    </form>
}

<br />
<a href="/Sucursal/Dashboard/@ViewBag.SucursalId">← Volver al Dashboard</a>