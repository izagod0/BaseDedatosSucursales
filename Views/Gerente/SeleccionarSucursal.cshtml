@model List<restauranteswebsbasededatos.Models.Sucursal>

@{
    ViewData["Title"] = "Seleccionar Sucursal";
    var usuarioNombre = ViewBag.UsuarioNombre;
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    body {
        background: #0f0f0f;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
    }
    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 30px;
    }
    .header {
        text-align: center;
        margin-bottom: 40px;
    }
    .header h1 {
        color: #fff;
        font-size: 32px;
        margin-bottom: 10px;
    }
    .header p {
        color: #888;
        font-size: 14px;
    }
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }
    .card {
        background: #1e1e2e;
        border: 1px solid #2a2a3e;
        border-radius: 15px;
        padding: 30px;
        text-align: center;
        transition: all 0.3s;
    }
    .card:hover {
        transform: translateY(-5px);
        border-color: #7c3aed;
    }
    .card-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }
    .card h3 {
        color: #fff;
        font-size: 20px;
        margin-bottom: 10px;
    }
    .card p {
        color: #888;
        font-size: 13px;
        margin-bottom: 20px;
    }
    .card a {
        display: inline-block;
        padding: 10px 25px;
        background: #7c3aed;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s;
    }
    .card a:hover {
        background: #6d28d9;
    }
    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #888;
        text-decoration: none;
        margin-right: 15px;
    }
</style>

<div class="container">
    <div class="header">
        <h1>🏪 Selecciona una Sucursal</h1>
        <p>Bienvenido, @usuarioNombre</p>
    </div>

    <div class="cards-grid">
        @foreach (var sucursal in Model)
        {
            <div class="card">
                <div class="card-icon">🏢</div>
                <h3>@sucursal.Nombre</h3>
                <p>@sucursal.Direccion</p>
                <p>📞 @sucursal.Telefono</p>
                <a href="/Gerente/Dashboard/@sucursal.Id">Gestionar →</a>
            </div>
        }
    </div>
</div>