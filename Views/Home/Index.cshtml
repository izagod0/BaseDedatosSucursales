@model List<restauranteswebsbasededatos.Models.Sucursal>

@{
    ViewData["Title"] = "Seleccionar Sucursal";
}

<h1>🏪 Selecciona una Sucursal</h1>

<div style="display: flex; gap: 20px; margin-top: 30px; flex-wrap: wrap;">
    @foreach (var sucursal in Model)
    {
        <div style="border: 1px solid #007bff; border-radius: 10px; padding: 20px; width: 250px; text-align: center;">
            <h2>🏢</h2>
            <h3>@sucursal.Nombre</h3>
            <p>@sucursal.Direccion</p>
            <p>📞 @sucursal.Telefono</p>
            <a href="/Sucursal/Dashboard/@sucursal.Id" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; margin-top: 10px;">
                Entrar →
            </a>
        </div>
    }
</div>