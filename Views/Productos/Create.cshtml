<h1>Agregar Producto</h1>

<form action="/Productos/Create" method="post">
    <div>
        <label>Nombre:</label>
        <input name="Nombre" required />
    </div>
    <div>
        <label>Precio:</label>
        <input name="Precio" type="number" step="0.01" required />
    </div>
    <div>
        <label>Stock:</label>
        <input name="Stock" type="number" required />
    </div>
    <div>
        <label>Fecha de Caducidad:</label>
        <input name="FechaCaducidad" type="date" required />
    </div>
    <div>
        <input type="submit" value="Guardar" />
        <a href="/Productos">Cancelar</a>
    </div>
</form>