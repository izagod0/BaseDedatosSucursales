<h1>Agregar Sucursal</h1>

<form action="/Sucursales/Create" method="post">
    <div>
        <label>Nombre:</label>
        <input name="Nombre" />
    </div>
    <div>
        <label>Dirección:</label>
        <input name="Direccion" />
    </div>
    <div>
        <label>Teléfono:</label>
        <input name="Telefono" />
    </div>
    <div>
        <input type="submit" value="Guardar" />
        <a href="/Sucursales">Cancelar</a>
    </div>
</form>