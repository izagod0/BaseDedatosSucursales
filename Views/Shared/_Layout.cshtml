<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Restaurante</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0f0f0f;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px;
        }
        .header {
            background: #1e1e2e;
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 30px;
            border: 1px solid #2a2a3e;
        }
        .header h1 {
            color: #fff;
            font-size: 28px;
            margin-bottom: 10px;
        }
        .header p {
            color: #888;
            font-size: 14px;
        }
        .card {
            background: #1e1e2e;
            border: 1px solid #2a2a3e;
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            transition: all 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
            border-color: #7c3aed;
        }
        .card-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }
        .card h3 {
            color: #fff;
            font-size: 18px;
            margin-bottom: 10px;
        }
        .card p {
            color: #888;
            font-size: 13px;
            margin-bottom: 20px;
        }
        .card a {
            display: inline-block;
            padding: 10px 20px;
            background: #7c3aed;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 13px;
            transition: all 0.3s;
        }
        .card a:hover {
            background: #6d28d9;
        }
        .btn-back {
            display: inline-block;
            padding: 10px 20px;
            background: #2a2a3e;
            color: #bbb;
            text-decoration: none;
            border-radius: 8px;
            margin-top: 20px;
        }
        table {
            width: 100%;
            background: #1e1e2e;
            border-radius: 15px;
            overflow: hidden;
            border-collapse: collapse;
        }
        th {
            background: #2a2a3e;
            color: #fff;
            padding: 15px;
            text-align: left;
        }
        td {
            padding: 12px 15px;
            color: #bbb;
            border-bottom: 1px solid #2a2a3e;
        }
        .status-red {
            background: #dc2626;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            color: white;
            display: inline-block;
        }
        .status-orange {
            background: #ea580c;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            color: white;
            display: inline-block;
        }
        .status-green {
            background: #10b981;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            color: white;
            display: inline-block;
        }
        .logout-btn {
            background: #2a2a3e;
            border: 1px solid #3a3a4e;
            color: #f87171;
            padding: 12px 25px;
            border-radius: 10px;
            text-decoration: none;
            display: inline-block;
        }
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>
</body>
</html>